# LaunchLocal Environment Variables
# Copy to .env.local and fill in values. All external services are optional;
# set MOCK_MODE=1 for zero-key development.

# ============================================================================
# Core App Config
# ============================================================================
NODE_ENV=development                    # development | production
APP_DOMAIN=localhost:3000               # Full domain for app; used in emails/links
APP_DOMAIN_PUBLIC=http://localhost:3000 # Full URL for public-facing links (http/https)

# Secret key for session encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=your-random-secret-here-32-bytes-minimum

# Enable mock adapters (zero-key dev mode)
MOCK_MODE=1                             # Set to "1" for mock places, AI, stripe, twilio

# ============================================================================
# Database (Required — M0)
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchlocal

# ============================================================================
# Authentication (Required — M0)
# ============================================================================
# Better Auth: email + Google OAuth
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application), authorized redirect URI: http://localhost:3000/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email sender (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Business Import (M1)
# ============================================================================
# Google Places API (New)
# https://cloud.google.com/docs/maps-platform/get-started
# Enable Places API (New) in Google Cloud Console

GOOGLE_PLACES_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxx

# ============================================================================
# AI Content Generation (M1)
# ============================================================================
# Anthropic API: https://console.anthropic.com/
# Using Claude 3.5 Sonnet for site generation

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Payments (M3)
# ============================================================================
# Stripe: https://dashboard.stripe.com/
# Test mode keys: stripe_test_...
# Two separate key pairs: one for Billing (our SaaS subs), one for Connect (tenant revenue)

# Billing API (our subscription plans)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxx

# Connect API (tenant payment destinations)
# Note: Connect onboarding creates accounts; webhooks on Connect events separate from Billing
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxx

# ============================================================================
# SMS Notifications (M4)
# ============================================================================
# Twilio: https://www.twilio.com/console
# MOCK_MODE=1 logs to console instead of sending

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1234567890  # Verified phone number for SMS

# ============================================================================
# Jobs & Scheduling (M2+)
# ============================================================================
# Inngest: https://app.inngest.com/
# Runs locally via pnpm dev:inngest (dev server, no external service needed)
# Production: deploy to Inngest Cloud

INNGEST_EVENT_KEY=eventkeyxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkeyxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Storage (M1+)
# ============================================================================
# S3-compatible storage: Cloudflare R2 (production) or local disk (dev)
# R2: https://dash.cloudflare.com/

R2_ACCOUNT_ID=abcdef1234567890
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=launchlocal-dev
R2_PUBLIC_URL=https://pub-xxxxxxx.r2.dev

# ============================================================================
# Rate Limiting (M5+)
# ============================================================================
# Upstash Redis: https://console.upstash.com/
# MOCK_MODE=1 uses in-memory fallback (dev only)

UPSTASH_REDIS_REST_URL=https://xxxxxxx-xxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================================================
# Observability (Optional)
# ============================================================================
# Sentry: https://sentry.io/ (error tracking)
SENTRY_DSN=https://xxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxxx

# PostHog: https://posthog.com/ (product analytics)
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Admin & Development
# ============================================================================
# Superadmin access via magic link on sign-in
# Leave blank; created via seed script or direct DB insert
SUPERADMIN_EMAIL=admin@launchlocal.test

# ============================================================================
# Notes
# ============================================================================
# - All external keys are optional. Set MOCK_MODE=1 to dev without them.
# - Secrets are read at server startup via validateEnv() (zod).
# - Never commit .env.local to git; .env* is in .gitignore.
# - For test/preview: create .env.test.local, .env.preview.local (same structure).
# - Stripe requires separate webhook secret for Billing vs. Connect events (different webhook URLs).
