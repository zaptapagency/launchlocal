{
  "name": "launchlocal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "concurrently \"next dev\" \"pnpm dev:inngest\"",
    "dev:web": "next dev",
    "dev:inngest": "inngest dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "node --loader tsx src/db/seed.ts",
    "db:reset": "pnpm db:drop && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "react": "^19.0.0-rc",
    "react-dom": "^19.0.0-rc",
    "next": "^15.1.0",
    "typescript": "^5.6.0",
    "@next/env": "^15.1.0",
    "@anthropic-ai/sdk": "^0.28.0",
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0",
    "better-auth": "^1.6.0",
    "stripe": "^15.0.0",
    "resend": "^3.0.0",
    "twilio": "^4.21.0",
    "inngest": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "react-hook-form": "^7.51.0",
    "lucide-react": "^0.408.0",
    "uuid": "^9.0.1",
    "pino": "^9.1.0",
    "pino-pretty": "^10.3.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/og": "^0.6.2",
    "next-themes": "^0.3.0",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "typescript-eslint": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "postcss": "^8.4.0",
    "@tailwindcss/forms": "^0.5.0",
    "autoprefixer": "^10.4.0",
    "vitest": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "playwright": "^1.45.0",
    "@playwright/test": "^1.45.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.16.0",
    "concurrently": "^8.2.0",
    "@hookform/resolvers": "^3.3.0",
    "js-cookie": "^3.0.5",
    "@types/js-cookie": "^3.0.6",
    "drizzle-zod": "^0.5.0"
  }
}
